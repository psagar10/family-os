# Family OS Environment Variables

# Database (Turso Cloud SQLite - free tier: 9GB storage, 500 databases)
# Get free account at https://turso.tech
DATABASE_URL=libsql://your-family-os.turso.io
DATABASE_AUTH_TOKEN=your_turso_auth_token

# Alternative: Local SQLite file (for development only, won't work on Vercel)
# DATABASE_URL=file:./data/family-os.db

# MiniMax AI (Your AI provider)
MINIMAX_API_KEY=your_api_key_here
MINIMAX_BASE_URL=https://v2.aicodee.com/
MINIMAX_MODEL=MiniMax-M2.7-highspeed

# Telegram Bot (Notifications)
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_ALLOWED_IDS=your_telegram_chat_id

# RapidAPI (Instagram scraping - optional, free tier available)
# Sign up at https://rapidapi.com
RAPIDAPI_KEY=your_rapidapi_key

# Google Calendar (Optional - for calendar sync)
# GOOGLE_CALENDAR_ID=your_calendar_id@group.calendar.google.com
