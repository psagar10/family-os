# Family OS Environment Variables
# Copy this to .env.local and fill in your values

# ===========================================
# DATABASE (SQLite - single file for both modules)
# ===========================================
DATABASE_PATH=./data/family-os.db

# ===========================================
# AI - MiniMax (all AI features use this)
# ===========================================
MINIMAX_API_KEY=your_minimax_api_key_here
MINIMAX_BASE_URL=https://v2.aicodee.com/
MINIMAX_MODEL=MiniMax-M2.7-highspeed

# ===========================================
# NOTIFICATIONS - Telegram Bot
# ===========================================
# Create bot via @BotFather, then set token here
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Comma-separated Telegram Chat IDs allowed to use the bot
# Leave empty to allow all (not recommended for production)
# To find your Chat ID: message @userinfobot on Telegram
TELEGRAM_ALLOWED_IDS=

# ===========================================
# INSTAGRAM SCRAPING - RapidAPI
# ===========================================
# Free tier available at https://rapidapi.com
# Used for extracting recipes from Instagram posts
RAPIDAPI_KEY=your_rapidapi_key_here

# ===========================================
# OPTIONAL: Google Calendar Integration
# ===========================================
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALENDAR_ID=primary
