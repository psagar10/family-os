{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "functions": {
    "app/api/**/*.ts": {
      "memory": 1024,
      "maxDuration": 10
    }
  },
  "crons": [
    {
      "path": "/api/cron/meal-plan-reminder",
      "schedule": "0 17 * * 0"
    },
    {
      "path": "/api/cron/meal-bridge-sync",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/task-plan-reminder",
      "schedule": "0 18 * * 0"
    },
    {
      "path": "/api/cron/day-before-notify",
      "schedule": "0 20 * * *"
    },
    {
      "path": "/api/cron/calendar-sync",
      "schedule": "0 */6 * * *"
    },
    {
      "path": "/api/cron/overdue-alert",
      "schedule": "0 */2 * * *"
    }
  ]
}
